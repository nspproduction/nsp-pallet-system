// Pallet dispatch system — Prisma schema
// Design principles:
//   1. Bulk counting (no per-unit tracking).
//   2. Balance maintained in WarehouseStock (snapshot) + StockMovement (ledger). Both updated in one transaction.
//   3. Every movement has a direction: fromDept (out) / toDept (in).
//   4. Requester and approver must differ (enforced at service layer).
//   5. Approval is multi-step; last step is always Pallet Manager (role=PALLET_MANAGER).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================================
// Users & organization
// =========================================================

enum UserRole {
  REQUESTER
  DEPT_APPROVER
  PALLET_MANAGER
  VIEWER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

model Department {
  id          String   @id @default(cuid())
  name        String
  isWarehouse Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  users          User[]
  sections       DepartmentSection[]
  approvalRoutes ApprovalRoute[]

  requestsFrom  Request[]       @relation("RequestFromDept")
  requestsTo    Request[]       @relation("RequestToDept")
  movementsFrom    StockMovement[] @relation("MovementFromDept")
  movementsTo      StockMovement[] @relation("MovementToDept")
  departmentStocks DepartmentStock[]

  @@map("departments")
}

model DepartmentSection {
  id           String     @id @default(cuid())
  departmentId String
  name         String
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  users      User[]

  requestsFrom               Request[] @relation("RequestFromSection")
  requestsTo                 Request[] @relation("RequestToSection")
  movementsFrom              StockMovement[] @relation("MovementFromSection")
  movementsTo                StockMovement[] @relation("MovementToSection")

  @@index([departmentId])
  @@map("department_sections")
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  fullName            String
  phone               String?
  roles               UserRole[] @default([REQUESTER])
  status              UserStatus @default(PENDING)
  passwordHash        String?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  departmentId        String?
  sectionId           String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  department          Department?        @relation(fields: [departmentId], references: [id])
  section             DepartmentSection? @relation(fields: [sectionId], references: [id])
  requests            Request[]          @relation("RequesterRequests")
  approvals           Approval[]
  auditLogs           AuditLog[]
  revisions           RequestRevision[]
  passwordResetTokens PasswordResetToken[]
  warehouseOps        WarehouseOperation[]
  notifications       Notification[]

  @@index([status])
  @@map("users")
}

// =========================================================
// Master data
// =========================================================

enum PalletCondition {
  GOOD           // ใช้งานได้ (ดี)
  PENDING_REPAIR // รอซ่อม
  DAMAGED        // เสีย (รอตัดจำหน่าย)
}

model PalletType {
  id          String  @id @default(cuid())
  name        String  @unique
  sizeSpec    String?
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requestItems      RequestItem[]
  movements         StockMovement[]
  warehouseStocks   WarehouseStock[]
  departmentStocks  DepartmentStock[]
  warehouseOpItems  WarehouseOperationItem[]

  @@map("pallet_types")
}

// =========================================================
// Warehouse stock snapshot (updated in same tx as StockMovement)
// =========================================================

model WarehouseStock {
  palletTypeId String
  condition    PalletCondition
  quantity     Int             @default(0)

  palletType   PalletType @relation(fields: [palletTypeId], references: [id])

  @@id([palletTypeId, condition])
  @@map("warehouse_stock")
}

// Department-level stock snapshot (updated in same tx as StockMovement)
// Allows negative (BR-3: return excess is warned, not blocked).
model DepartmentStock {
  palletTypeId String
  condition    PalletCondition
  departmentId String
  quantity     Int             @default(0)

  palletType  PalletType @relation(fields: [palletTypeId], references: [id])
  department  Department @relation(fields: [departmentId], references: [id])

  @@id([palletTypeId, condition, departmentId])
  @@map("department_stock")
}

// =========================================================
// Approval routes (configured per dept × request type)
// =========================================================

model ApprovalRoute {
  id           String      @id @default(cuid())
  departmentId String
  requestType  RequestType // ISSUE or RETURN
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  department Department    @relation(fields: [departmentId], references: [id])
  steps      ApprovalStep[]

  @@unique([departmentId, requestType])
  @@map("approval_routes")
}

model ApprovalStep {
  id          String   @id @default(cuid())
  routeId     String
  stepOrder   Int
  name        String
  approverIds String[]

  route ApprovalRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, stepOrder])
  @@index([routeId])
  @@map("approval_steps")
}

// =========================================================
// Operating hours + holidays
// =========================================================

model OperatingHours {
  id        String   @id @default(cuid())
  dayOfWeek Int      // 0=Sun 1=Mon … 6=Sat
  startTime String   // "09:00"
  endTime   String   // "11:30"
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("operating_hours")
}

model HolidayDate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("holiday_dates")
}

// =========================================================
// Requests (ISSUE / RETURN only — workflow requests)
// =========================================================

enum RequestType {
  ISSUE  // เบิกออก (SPEC §6)
  RETURN // คืนเข้า (SPEC §6)
}

enum RequestStatus {
  DRAFT
  PENDING_DEPT      // รอ dept-step approver
  PENDING_WAREHOUSE // รอ Pallet Manager (final step)
  COMPLETED         // อนุมัติครบ + ยอดเปลี่ยนแล้ว
  REJECTED
  CANCELLED
}

model Request {
  id     String        @id @default(cuid())
  docNo  String        @unique
  type   RequestType
  status RequestStatus @default(PENDING_DEPT)

  requesterId String
  requester   User   @relation("RequesterRequests", fields: [requesterId], references: [id])

  fromDepartmentId String?
  fromDepartment   Department?        @relation("RequestFromDept", fields: [fromDepartmentId], references: [id])
  fromSectionId    String?
  fromSection      DepartmentSection? @relation("RequestFromSection", fields: [fromSectionId], references: [id])
  toDepartmentId   String?
  toDepartment     Department?        @relation("RequestToDept", fields: [toDepartmentId], references: [id])
  toSectionId      String?
  toSection        DepartmentSection? @relation("RequestToSection", fields: [toSectionId], references: [id])

  // Condition for this request (1 condition per request — SPEC §6)
  condition PalletCondition?

  // Multi-step approval state
  currentStepOrder Int?  // null = at PENDING_WAREHOUSE / completed
  stepSnapshot     Json? // snapshot of dept steps at submission time

  neededDate  DateTime?
  purpose     String?
  note        String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  submittedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  items       RequestItem[]
  approvals   Approval[]
  movements   StockMovement[]
  revisions   RequestRevision[]
  attachments RequestAttachment[]

  @@index([status, type])
  @@index([requesterId, status])
  @@index([createdAt])
  @@map("requests")
}

model RequestItem {
  id        String  @id @default(cuid())
  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  palletTypeId String
  palletType   PalletType @relation(fields: [palletTypeId], references: [id])

  quantity Int
  note     String?

  @@index([requestId])
  @@map("request_items")
}

model RequestRevision {
  id         String   @id @default(cuid())
  requestId  String
  editedById String
  reason     String
  before     Json
  after      Json
  createdAt  DateTime @default(now())

  request  Request @relation(fields: [requestId], references: [id])
  editedBy User    @relation(fields: [editedById], references: [id])

  @@index([requestId])
  @@map("request_revisions")
}

model RequestAttachment {
  id        String   @id @default(cuid())
  requestId String
  request   Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  filePath  String
  mimeType  String   @default("image/jpeg")
  sizeBytes Int?
  createdAt DateTime @default(now())

  @@index([requestId])
  @@map("request_attachments")
}

model Approval {
  id        String           @id @default(cuid())
  requestId String
  request   Request          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approverId String
  approver  User             @relation(fields: [approverId], references: [id])
  decision  ApprovalDecision
  comment   String?
  step      Int              @default(1)
  stepName  String?
  decidedAt DateTime         @default(now())

  @@index([requestId])
  @@map("approvals")
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  EDIT_APPROVED
}

// =========================================================
// Warehouse operations (REPAIR_RESULT, WRITE_OFF, ADJUSTMENT)
// These bypass approval workflow — Pallet Manager / Admin acts directly
// =========================================================

enum WarehouseOpType {
  REPAIR_RESULT  // บันทึกผลซ่อม
  WRITE_OFF      // ตัดจำหน่าย
  ADJUSTMENT     // ปรับยอด
}

model WarehouseOperation {
  id          String          @id @default(cuid())
  docNo       String          @unique
  type        WarehouseOpType
  reason      String?
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  opItems   WarehouseOperationItem[]
  movements StockMovement[]

  @@index([type, createdAt])
  @@map("warehouse_operations")
}

model WarehouseOperationItem {
  id             String           @id @default(cuid())
  operationId    String
  operation      WarehouseOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  palletTypeId   String
  palletType     PalletType       @relation(fields: [palletTypeId], references: [id])

  fromCondition  PalletCondition?
  toCondition    PalletCondition?
  quantity       Int

  @@index([operationId])
  @@map("warehouse_operation_items")
}

// =========================================================
// Stock ledger (append-only, source of truth for audit)
// =========================================================

model StockMovement {
  id              String          @id @default(cuid())
  movementGroupId String          @default(cuid())

  requestId        String?
  request          Request?          @relation(fields: [requestId], references: [id])
  warehouseOpId    String?
  warehouseOp      WarehouseOperation? @relation(fields: [warehouseOpId], references: [id])

  palletTypeId String
  palletType   PalletType      @relation(fields: [palletTypeId], references: [id])

  condition PalletCondition
  quantity  Int

  fromDepartmentId String?
  fromDepartment   Department?        @relation("MovementFromDept", fields: [fromDepartmentId], references: [id])
  fromSectionId    String?
  fromSection      DepartmentSection? @relation("MovementFromSection", fields: [fromSectionId], references: [id])
  toDepartmentId   String?
  toDepartment     Department?        @relation("MovementToDept", fields: [toDepartmentId], references: [id])
  toSectionId      String?
  toSection        DepartmentSection? @relation("MovementToSection", fields: [toSectionId], references: [id])

  reason     String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([palletTypeId, condition])
  @@index([fromDepartmentId])
  @@index([toDepartmentId])
  @@index([occurredAt])
  @@map("stock_movements")
}

// =========================================================
// Email outbox
// =========================================================

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model EmailOutbox {
  id        String      @id @default(cuid())
  to        String
  subject   String
  bodyHtml  String
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?
  createdAt DateTime    @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
  @@map("email_outbox")
}

// =========================================================
// Password reset tokens
// =========================================================

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// =========================================================
// Notifications, audit
// =========================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  requestId String?
  subject   String?
  body      String
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model DocCounter {
  key       String   @id
  seq       Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("doc_counters")
}
